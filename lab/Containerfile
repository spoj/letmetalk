# Lab images. Build from the repo root, for example:
#   podman build -f lab/Containerfile --target router -t lab-router .
FROM docker.io/library/rust:1-bookworm AS rust
WORKDIR /src
COPY Cargo.toml Cargo.lock ./
COPY .cargo .cargo
COPY crates crates
RUN cargo build --release --locked -p letmetalk-signal --bin letmetalk-signal --example login \
 && cp target/release/letmetalk-signal target/release/examples/login /usr/local/bin/

FROM docker.io/library/rust:1-bookworm AS iroh
RUN cargo install --locked --version 1.3.0 --features server --root /usr/local iroh-relay

FROM docker.io/library/debian:bookworm-slim AS base
ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update \
 && apt-get install -y --no-install-recommends ca-certificates coturn iproute2 nftables openssl socat \
 && rm -rf /var/lib/apt/lists/*
COPY lab /lab

FROM base AS router
ENTRYPOINT ["/lab/router.sh"]

FROM base AS coturn
COPY crates/letmetalk-signal/coturn /lab/coturn
ENTRYPOINT ["/lab/coturn.sh"]

FROM base AS signal
COPY --from=rust /usr/local/bin/letmetalk-signal /usr/local/bin/
ENTRYPOINT ["letmetalk-signal"]

FROM base AS iroh-relay
COPY --from=iroh /usr/local/bin/iroh-relay /usr/local/bin/
ENTRYPOINT ["iroh-relay"]

FROM base AS peer
COPY --from=rust /usr/local/bin/login /usr/local/bin/
ENTRYPOINT ["/lab/peer.sh"]
CMD ["sleep", "infinity"]

FROM mcr.microsoft.com/playwright:v1.56.0-noble AS browser
RUN apt-get update \
 && apt-get install -y --no-install-recommends coturn iproute2 socat \
 && rm -rf /var/lib/apt/lists/*
COPY lab /lab
COPY --from=rust /usr/local/bin/login /usr/local/bin/
ENTRYPOINT ["/lab/peer.sh"]
CMD ["sleep", "infinity"]
